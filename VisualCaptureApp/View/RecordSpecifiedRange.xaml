<Page x:Class="VisualCaptureApp.View.RecordSpecifiedRange"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VisualCaptureApp.View"
      mc:Ignorable="d"       
      Title="RecordSpecifiedRange"
      Loaded="PageOnLoad"
      >

    <Grid>
        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,0">
            <StackPanel>
                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,0,0" Orientation="Vertical">
                    <WrapPanel>
                        <!-- FPS/幀率 -->
                        <TextBlock Text="FPS/幀率:" FontSize="12" FontWeight="Bold" Margin="5,5,0,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- 目前數值顯示 -->
                        <TextBlock x:Name="TextBlockFPS" Text="" FontSize="14" FontWeight="Bold" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="Blue"/>
                    </WrapPanel>

                    <Slider x:Name="SliderFPS" 
                        Minimum="1"
                        Maximum="100"
                        Value="30"
                        SelectionStart="20"
                        SelectionEnd="40"
                        IsSelectionRangeEnabled="True"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        HorizontalAlignment="Stretch"
                        Width="Auto"
                        ValueChanged="SliderFPS_ValueChanged"                            
                        />
                </StackPanel>
                <!-- 分隔線 -->
                <Border Height="1" Background="#BBBBBB" Margin="1,3,1,0"/>

                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,0,0" Orientation="Vertical">
                    <WrapPanel>
                        <!-- 影像品質/VideoQuality-->
                        <TextBlock Text="影像品質/VideoQuality: 1 (最佳畫質)" FontSize="12" FontWeight="Bold" Margin="5,5,0,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TextBlockVideoQuality" Text="" FontSize="14" FontWeight="Bold" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="Blue"/>
                    </WrapPanel>
                    <Slider x:Name="SliderVideoQuality"
                        Minimum="1"
                        Maximum="31"
                        Value="5"
                        SelectionStart="5"
                        SelectionEnd="20"
                        IsSelectionRangeEnabled="True"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        HorizontalAlignment="Stretch"
                        Width="Auto"
                        ValueChanged="SliderVideoQuality_ValueChanged"/>

                </StackPanel>

                <!-- 分隔線 -->
                <Border Height="1" Background="#BBBBBB" Margin="1,3,1,0"/>

                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,0,0" Orientation="Vertical">
                    <WrapPanel>
                        <!-- 錄製時間/RecordTime:-->
                        <TextBlock Text="錄製時間/RecordTime:(DD/HH/MM:SS)" FontSize="12" FontWeight="Bold" Margin="5,5,0,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock x:Name="TextBlockRecordTime" Text="{Binding RecordTimeDate, Mode=TwoWay}" FontSize="14" FontWeight="Bold" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="Blue"/>
                    </WrapPanel>
                </StackPanel>
                <!-- 分隔線 -->
                <Border Height="1" Background="#BBBBBB" Margin="1,3,1,0"/>

                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,0,0" Orientation="Vertical">
                    <WrapPanel>
                        <!-- 錄製音效/RecordAudio:-->
                        <TextBlock Text="錄製音效/RecordAudio:" FontSize="12" FontWeight="Bold" Margin="5,5,0,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <WrapPanel>
                        <!-- 下拉音效清單 -->
                        <ComboBox x:Name="ComboxAudio" Width="Auto" Margin="0,0,0,0" FontFamily="Calibri" FontSize="12" Background="Yellow" SelectionChanged="ComboxAudio_SelectionChanged">
                            <!--<ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>-->
                        </ComboBox>

                        <!-- CheckBox 錄製音效 -->
                        <CheckBox x:Name="CheckBoxAudio" Content=""
                      IsChecked="{Binding IsRecordAudio, Mode=TwoWay}"
                      Margin="5,5,0,0"
                      >
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="IsThreeState" Value="False"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Background" Value="LightGreen"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>

                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                    </WrapPanel>
                </StackPanel>
                <!-- 分隔線 -->
                <Border Height="1" Background="#BBBBBB" Margin="1,3,1,0"/>

                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,0,0" Orientation="Vertical">
                    <WrapPanel>
                        <!-- Width-->
                        <TextBlock Text="Width" FontSize="12" FontWeight="Bold" Margin="5,5,0,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TextBlockWidth" Text="{Binding BaseSpecifiedRange.Width, Mode=TwoWay}" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Blue"/>
                    </WrapPanel>
                    <WrapPanel>
                        <!-- Height-->
                        <TextBlock Text="Height" FontSize="12" FontWeight="Bold" Margin="5,5,0,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TextBlockHeight" Text="{Binding BaseSpecifiedRange.Height, Mode=TwoWay}" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Blue"/>
                    </WrapPanel>
                    <WrapPanel>
                        <!-- Left-->
                        <TextBlock Text="Left" FontSize="12" FontWeight="Bold" Margin="5,5,0,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TextBlockLeft" Text="{Binding BaseSpecifiedRange.Left, Mode=TwoWay}" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Blue"/>
                    </WrapPanel>
                    <WrapPanel>
                        <!-- Top-->
                        <TextBlock Text="Top" FontSize="12" FontWeight="Bold" Margin="5,5,0,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TextBlockTop" Text="{Binding BaseSpecifiedRange.Top, Mode=TwoWay}" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Blue"/>
                    </WrapPanel>
                    <WrapPanel>
                        <!-- BorderThickness-->
                        <TextBlock Text="BorderThickness" FontSize="12" FontWeight="Bold" Margin="5,5,0,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TextBlockBorderThickness" Text="{Binding BaseSpecifiedRange.BorderThickness, Mode=TwoWay}" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Blue"/>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
