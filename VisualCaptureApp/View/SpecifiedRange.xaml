<Window x:Class="VisualCaptureApp.View.SpecifiedRange"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"        
        xmlns:converter="clr-namespace:VisualCaptureApp.ValueConverter"
        mc:Ignorable="d"
        Title="SpecifiedRange"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"        
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" 
        Loaded="WindowOnLoad"
        >

    <Window.Resources>
        <converter:HalfValueConverter x:Key="HalfValueConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.Resources>
            <Style TargetType="Thumb">
                <Setter Property="Opacity" Value="0.01"/>
                <EventSetter Event="DragDelta" Handler="Thumb_OnDragDelta"/>
            </Style>
            <Style x:Key="CornerThumb" TargetType="Thumb" BasedOn="{StaticResource {x:Type Thumb}}">
                <Setter Property="Height" Value="5"/>
                <Setter Property="Width" Value="5"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border BorderThickness="{Binding SpecifiedRangeBorderThickness, Mode=TwoWay}"
                Name="Region"                
                MinHeight="50"
                MinWidth="100">
            <Border.BorderBrush>
                <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="{Binding SpecifiedRangeBorderColor1, Mode=TwoWay}">
                                <!--<GeometryDrawing.Brush>
                                    <SolidColorBrush Color="Yellow"/>
                                </GeometryDrawing.Brush>-->
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="0,0,10,10" />
                                        <RectangleGeometry Rect="10,10,10,10" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>

                            <GeometryDrawing Brush="{Binding SpecifiedRangeBorderColor2, Mode=TwoWay}">
                                <!--<GeometryDrawing.Brush>
                                    <SolidColorBrush Color="Black"/>
                                </GeometryDrawing.Brush>-->
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="10,0,10,10" />
                                        <RectangleGeometry Rect="0,10,10,10" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.BorderBrush>

            <Grid>
                <!-- 中央十字線 -->
                <Canvas Name="CrossCanvas" Visibility="{Binding IsShowCrossCanvas, Converter={StaticResource BoolToVis}}" Background="Transparent">
                    <Canvas.Resources>
                        <Style x:Key="DashedLine1" TargetType="Line">
                            <Setter Property="StrokeThickness" Value="2"/>
                            <Setter Property="StrokeDashArray" Value="6,2"/>
                            <!-- 虛線樣式 -->
                        </Style>
                        <Style x:Key="DashedLine2" TargetType="Line">
                            <Setter Property="StrokeThickness" Value="2"/>
                            <Setter Property="StrokeDashArray" Value="4,4"/>
                            <!-- 虛線樣式 -->
                        </Style>
                    </Canvas.Resources>

                    <!-- 垂直虛線 -->
                    <Line X1="0"
                          Y1="{Binding ActualHeight, ElementName=CrossCanvas, Converter={StaticResource HalfValueConverter}}"
                          X2="{Binding ActualWidth, ElementName=CrossCanvas}"
                          Y2="{Binding ActualHeight, ElementName=CrossCanvas, Converter={StaticResource HalfValueConverter}}"
                          Stroke="{Binding SpecifiedRangeBorderColor1}"
                          Style="{StaticResource DashedLine1}"/>

                    <Line X1="0"
                          Y1="{Binding ActualHeight, ElementName=CrossCanvas, Converter={StaticResource HalfValueConverter}}"
                          X2="{Binding ActualWidth, ElementName=CrossCanvas}"
                          Y2="{Binding ActualHeight, ElementName=CrossCanvas, Converter={StaticResource HalfValueConverter}}"
                          Stroke="{Binding SpecifiedRangeBorderColor2}"
                          Style="{StaticResource DashedLine2}"/>

                    <!-- 水平虛線 -->
                    <Line X1="{Binding ActualWidth, ElementName=CrossCanvas, Converter={StaticResource HalfValueConverter}}"
                          Y1="0"
                          X2="{Binding ActualWidth, ElementName=CrossCanvas, Converter={StaticResource HalfValueConverter}}"
                          Y2="{Binding ActualHeight, ElementName=CrossCanvas}"
                          Stroke="{Binding SpecifiedRangeBorderColor1}"
                          Style="{StaticResource DashedLine1}"/>

                    <Line X1="{Binding ActualWidth, ElementName=CrossCanvas, Converter={StaticResource HalfValueConverter}}"
                          Y1="0"
                          X2="{Binding ActualWidth, ElementName=CrossCanvas, Converter={StaticResource HalfValueConverter}}"
                          Y2="{Binding ActualHeight, ElementName=CrossCanvas}"
                          Stroke="{Binding SpecifiedRangeBorderColor2}"
                          Style="{StaticResource DashedLine2}"/>                   
                </Canvas>

                <!-- 十字線上的水平拖曳 Thumb -->
                <Thumb HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       Height="5"
                       Cursor="SizeAll"
                       Tag="Move"/>
                <!-- 十字線上的垂直拖曳 Thumb -->
                <Thumb HorizontalAlignment="Center"
                       VerticalAlignment="Stretch"
                       Width="5"
                       Cursor="SizeAll"
                       Tag="Move"/>                
            </Grid>

            <!--<Thumb HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Height="2"
                   Cursor="SizeAll"
                   Tag="Move"/>-->

        </Border>

        <Thumb VerticalAlignment="Top"
               Height="2"
               Cursor="SizeAll"
               Tag="Top"/>

        <Grid Grid.Row="0"
              Grid.Column="0"
              IsEnabled="True">
            <Thumb VerticalAlignment="Bottom"
               Height="2"
               Cursor="SizeNS"
               Tag="Bottom"/>

            <Thumb HorizontalAlignment="Left"
               Width="2"
               Cursor="SizeWE"
               Tag="Left"/>

            <Thumb HorizontalAlignment="Right"
               Width="2"
               Cursor="SizeWE"
               Tag="Right"/>

            <Thumb HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Style="{StaticResource CornerThumb}"
               Cursor="SizeNWSE"
               Tag="TopLeft"/>

            <Thumb HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Style="{StaticResource CornerThumb}"
               Cursor="SizeNESW"
               Tag="TopRight"/>

            <Thumb HorizontalAlignment="Left"
               VerticalAlignment="Bottom"
               Style="{StaticResource CornerThumb}"
               Cursor="SizeNESW"
               Tag="BottomLeft"/>

            <Thumb HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Style="{StaticResource CornerThumb}"
               Cursor="SizeNWSE"
               Tag="BottomRight"/>
        </Grid>
        
    </Grid>
</Window>
